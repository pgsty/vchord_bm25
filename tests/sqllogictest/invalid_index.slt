# Scalar scoring must reject an invalid index (left by a failed CREATE INDEX
# CONCURRENTLY) before reading its pages, instead of reporting corruption or
# using incomplete statistics.
statement ok
CREATE TABLE invalid_docs (id integer PRIMARY KEY, body text);

statement ok
INSERT INTO invalid_docs SELECT i, 'document ' || i FROM generate_series(1, 100) AS i;

statement ok
INSERT INTO invalid_docs VALUES (101, 'boom');

statement ok
CREATE FUNCTION invalid_docs_tsv(text) RETURNS tsvector IMMUTABLE LANGUAGE plpgsql AS $$
BEGIN
    IF $1 = 'boom' THEN
        RAISE EXCEPTION 'cannot index %', $1;
    END IF;
    RETURN to_tsvector('simple', $1);
END
$$;

statement error cannot index boom
CREATE INDEX CONCURRENTLY invalid_docs_bm25 ON invalid_docs USING bm25 ((invalid_docs_tsv(body)) bm25_ops);

query II
SELECT indisvalid::int, indisready::int FROM pg_index WHERE indexrelid = 'invalid_docs_bm25'::regclass;
----
0 0

statement error index "invalid_docs_bm25" is not valid
SELECT invalid_docs_tsv(body) <&> to_bm25query(to_tsvector('simple', 'document'), 'invalid_docs_bm25')
FROM invalid_docs WHERE id = 1;

statement error index "invalid_docs_bm25" is not valid
SELECT bm25_maintain('invalid_docs_bm25');

statement ok
CREATE FUNCTION invalid_docs_maintain_sqlstate() RETURNS text LANGUAGE plpgsql AS $$
BEGIN
    PERFORM bm25_maintain('invalid_docs_bm25');
    RETURN 'no error';
EXCEPTION WHEN OTHERS THEN
    RETURN SQLSTATE;
END
$$;

query T
SELECT invalid_docs_maintain_sqlstate();
----
55000

statement ok
CREATE FUNCTION invalid_docs_sqlstate() RETURNS text LANGUAGE plpgsql AS $$
BEGIN
    PERFORM invalid_docs_tsv(body) <&> to_bm25query(to_tsvector('simple', 'document'), 'invalid_docs_bm25')
    FROM invalid_docs WHERE id = 1;
    RETURN 'no error';
EXCEPTION WHEN OTHERS THEN
    RETURN SQLSTATE;
END
$$;

query T
SELECT invalid_docs_sqlstate();
----
55000

# The planner never scans an invalid index; ordering by a query that targets
# it falls back to scalar scoring and gets the same error.
statement ok
SET enable_seqscan = off;

statement error index "invalid_docs_bm25" is not valid
SELECT id FROM invalid_docs
ORDER BY invalid_docs_tsv(body) <&> to_bm25query(to_tsvector('simple', 'document'), 'invalid_docs_bm25')
LIMIT 3;

statement ok
RESET enable_seqscan;

# Permissions are checked first: a role that cannot read the table learns
# nothing about the index's state.
statement ok
CREATE ROLE invalid_docs_reader;

statement ok
SET ROLE invalid_docs_reader;

statement error permission denied for table invalid_docs
SELECT to_tsvector('simple', 'document 1') <&> to_bm25query(to_tsvector('simple', 'document'), 'invalid_docs_bm25');

statement ok
RESET ROLE;

statement ok
DROP ROLE invalid_docs_reader;

# REINDEX makes it valid again once the data can be indexed.
statement ok
DELETE FROM invalid_docs WHERE body = 'boom';

statement ok
REINDEX INDEX invalid_docs_bm25;

query I
SELECT indisvalid::int FROM pg_index WHERE indexrelid = 'invalid_docs_bm25'::regclass;
----
1

query I
SELECT (invalid_docs_tsv(body) <&> to_bm25query(to_tsvector('simple', 'document'), 'invalid_docs_bm25') < 0)::int
FROM invalid_docs WHERE id = 1;
----
1

query T
SELECT invalid_docs_sqlstate();
----
no error

query T
SELECT invalid_docs_maintain_sqlstate();
----
no error

# Partitioned parent indexes have no physical storage and must be rejected cleanly.
statement ok
CREATE TABLE part_maintain_docs (id integer, body tsvector) PARTITION BY RANGE (id);

statement ok
CREATE TABLE part_maintain_docs_p1 PARTITION OF part_maintain_docs FOR VALUES FROM (1) TO (100);

statement ok
CREATE INDEX part_maintain_docs_bm25 ON part_maintain_docs USING bm25 (body bm25_ops);

statement error is not an index
SELECT bm25_maintain('part_maintain_docs_bm25');

statement ok
DROP TABLE part_maintain_docs;

statement ok
DROP TABLE invalid_docs;

statement ok
DROP FUNCTION invalid_docs_maintain_sqlstate();

statement ok
DROP FUNCTION invalid_docs_sqlstate();

statement ok
DROP FUNCTION invalid_docs_tsv(text);
