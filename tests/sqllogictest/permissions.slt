# Native scans use the same contract, even with grants on every referenced column.
query I
SELECT ((p->>'Node Type' = 'Index Scan') AND (p->>'Index Name' = 'expressions_bm25'))::int
FROM (SELECT bm25_perm_data.plan($q$SELECT content FROM bm25_perm_data.expressions ORDER BY to_tsvector('simple', content) OPERATOR(bm25_perm_api.<&>) bm25_perm_api.to_bm25query('search:1', 'bm25_perm_data.expressions_bm25')$q$) AS p) AS plan;
