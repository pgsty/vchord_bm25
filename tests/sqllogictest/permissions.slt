FROM (SELECT bm25_perm_data.plan($q$SELECT vector FROM bm25_perm_data.partials WHERE secret ORDER BY vector OPERATOR(bm25_perm_api.<&>) bm25_perm_api.to_bm25query('search:1', 'bm25_perm_data.partials_bm25')$q$) AS p) AS plan;
