# Confirm an actual Index Scan before asserting rejection: projecting vector
# does not execute the scalar operator as a separate output expression.
query I
SELECT ((p->>'Node Type' = 'Index Scan') AND (p->>'Index Name' = 'documents_bm25'))::int
FROM (SELECT bm25_perm_data.plan($q$SELECT vector FROM bm25_perm_data.documents ORDER BY vector OPERATOR(bm25_perm_api.<&>) bm25_perm_api.to_bm25query('search:1', 'bm25_perm_data.documents_bm25')$q$) AS p) AS plan;
