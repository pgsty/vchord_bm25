# Prefiltering evaluates the scan's qual inside the index and the executor
# evaluates it again. Quals with SubPlans must not be prefiltered: their
# side effects would run twice (and random choices compound).
statement ok
CREATE TABLE prefilter_sub_docs (id integer PRIMARY KEY, tag integer, body tsvector);

statement ok
INSERT INTO prefilter_sub_docs
SELECT i, i % 5, to_tsvector('simple', 'term ' || CASE WHEN i % 3 = 0 THEN 'other ' ELSE '' END || 'filler' || i)
FROM generate_series(1, 60) AS i;

statement ok
CREATE INDEX prefilter_sub_bm25 ON prefilter_sub_docs USING bm25 (body bm25_ops);

statement ok
CREATE TABLE prefilter_sub_ok (id integer, tag integer);

statement ok
INSERT INTO prefilter_sub_ok SELECT i, i % 5 FROM generate_series(1, 60) AS i WHERE i % 2 = 0;

statement ok
CREATE SEQUENCE prefilter_sub_calls;

# Counts its calls; accepts even ids.
statement ok
CREATE FUNCTION prefilter_sub_count(id integer) RETURNS boolean VOLATILE LANGUAGE plpgsql AS $$
BEGIN
    PERFORM nextval('prefilter_sub_calls');
    RETURN id % 2 = 0;
END
$$;

statement ok
CREATE FUNCTION prefilter_sub_plan(query text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE line text; result text := '';
BEGIN
    FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
        result := result || line || E'\n';
    END LOOP;
    RETURN result;
END
$$;

# Runs a query, returning its row count, the sum of its ids and the number of
# prefilter_sub_count() calls it made.
statement ok
CREATE FUNCTION prefilter_sub_run(query text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE n bigint; s bigint; before bigint; after bigint;
BEGIN
    SELECT nextval('prefilter_sub_calls') INTO before;
    EXECUTE 'SELECT count(*), coalesce(sum(id), 0) FROM (' || query || ') AS q' INTO n, s;
    SELECT nextval('prefilter_sub_calls') INTO after;
    RETURN n || ' ' || s || ' ' || (after - before - 1);
END
$$;

statement ok
SET enable_seqscan = off;

statement ok
SET "bm25.limit" = 4;

# A correlated SubPlan with a side effect, kept as a SubPlan because it is
# volatile.
query I
SELECT (prefilter_sub_plan($q$
SELECT id FROM prefilter_sub_docs AS d
WHERE EXISTS (SELECT 1 WHERE prefilter_sub_count(d.id))
ORDER BY d.body <&> to_bm25query(to_tsvector('simple', 'term'), 'prefilter_sub_bm25')
$q$) ~ 'Index Scan using prefilter_sub_bm25(.|\n)*SubPlan')::int;
----
1

statement ok
SET bm25.prefilter = off;

query T
SELECT prefilter_sub_run($q$
SELECT id FROM prefilter_sub_docs AS d
WHERE EXISTS (SELECT 1 WHERE prefilter_sub_count(d.id))
ORDER BY d.body <&> to_bm25query(to_tsvector('simple', 'term'), 'prefilter_sub_bm25')
$q$);
----
30 930 60

statement ok
SET bm25.prefilter = on;

query T
SELECT prefilter_sub_run($q$
SELECT id FROM prefilter_sub_docs AS d
WHERE EXISTS (SELECT 1 WHERE prefilter_sub_count(d.id))
ORDER BY d.body <&> to_bm25query(to_tsvector('simple', 'term'), 'prefilter_sub_bm25')
$q$);
----
30 930 60

# Parameterized rescans: the query vector comes from the outer row.
query I
SELECT (prefilter_sub_plan($q$
SELECT k.word, r.id FROM (VALUES ('term'), ('other')) AS k(word),
LATERAL (
    SELECT id FROM prefilter_sub_docs AS d
    WHERE EXISTS (SELECT 1 WHERE prefilter_sub_count(d.id))
    ORDER BY d.body <&> to_bm25query(to_tsvector('simple', k.word), 'prefilter_sub_bm25')
    LIMIT 3
) AS r
$q$) LIKE '%Index Scan using prefilter_sub_bm25%')::int;
----
1

statement ok
SET bm25.prefilter = off;

query T
SELECT prefilter_sub_run($q$
SELECT r.id FROM (VALUES ('term'), ('other'), ('term')) AS k(word),
LATERAL (
    SELECT id FROM prefilter_sub_docs AS d
    WHERE EXISTS (SELECT 1 WHERE prefilter_sub_count(d.id))
    ORDER BY d.body <&> to_bm25query(to_tsvector('simple', k.word), 'prefilter_sub_bm25')
    LIMIT 3
) AS r
$q$);
----
9 64 18

statement ok
SET bm25.prefilter = on;

query T
SELECT prefilter_sub_run($q$
SELECT r.id FROM (VALUES ('term'), ('other'), ('term')) AS k(word),
LATERAL (
    SELECT id FROM prefilter_sub_docs AS d
    WHERE EXISTS (SELECT 1 WHERE prefilter_sub_count(d.id))
    ORDER BY d.body <&> to_bm25query(to_tsvector('simple', k.word), 'prefilter_sub_bm25')
    LIMIT 3
) AS r
$q$);
----
9 64 18

# A non-volatile correlated SubPlan (a scalar sublink is never pulled up into
# a join) gives the same rows either way.
query I
SELECT (prefilter_sub_plan($q$
SELECT id FROM prefilter_sub_docs AS d
WHERE (SELECT count(*) FROM prefilter_sub_ok AS o WHERE o.id = d.id AND o.tag = d.tag) > 0
ORDER BY d.body <&> to_bm25query(to_tsvector('simple', 'other'), 'prefilter_sub_bm25')
$q$) ~ 'Index Scan using prefilter_sub_bm25(.|\n)*SubPlan')::int;
----
1

statement ok
SET bm25.prefilter = off;

query T
SELECT prefilter_sub_run($q$
SELECT id FROM prefilter_sub_docs AS d
WHERE (SELECT count(*) FROM prefilter_sub_ok AS o WHERE o.id = d.id AND o.tag = d.tag) > 0
ORDER BY d.body <&> to_bm25query(to_tsvector('simple', 'other'), 'prefilter_sub_bm25')
$q$);
----
30 930 0

statement ok
SET bm25.prefilter = on;

query T
SELECT prefilter_sub_run($q$
SELECT id FROM prefilter_sub_docs AS d
WHERE (SELECT count(*) FROM prefilter_sub_ok AS o WHERE o.id = d.id AND o.tag = d.tag) > 0
ORDER BY d.body <&> to_bm25query(to_tsvector('simple', 'other'), 'prefilter_sub_bm25')
$q$);
----
30 930 0

# Plain quals are still prefiltered and give the same rows.
query T
SELECT prefilter_sub_run($q$
SELECT id FROM prefilter_sub_docs AS d
WHERE d.tag = 1
ORDER BY d.body <&> to_bm25query(to_tsvector('simple', 'term'), 'prefilter_sub_bm25')
$q$);
----
12 342 0

statement ok
RESET bm25.prefilter;

statement ok
RESET "bm25.limit";

statement ok
RESET enable_seqscan;

statement ok
DROP TABLE prefilter_sub_docs, prefilter_sub_ok;

statement ok
DROP FUNCTION prefilter_sub_run(text);

statement ok
DROP FUNCTION prefilter_sub_plan(text);

statement ok
DROP FUNCTION prefilter_sub_count(integer);

statement ok
DROP SEQUENCE prefilter_sub_calls;
