# Natural plans: never disable sequential scans for ranking assertions.
statement ok
CREATE TABLE cost_documents (id integer PRIMARY KEY, vector tsvector);

statement ok
INSERT INTO cost_documents SELECT i, to_tsvector('simple', 'search term ' || i) FROM generate_series(1, 50000) AS i;

statement ok
CREATE INDEX cost_documents_bm25 ON cost_documents USING bm25 (vector bm25_ops);

statement ok
VACUUM (ANALYZE) cost_documents;

statement ok
CREATE FUNCTION bm25_test_plan(query text) RETURNS jsonb LANGUAGE plpgsql AS $$
DECLARE result jsonb;
BEGIN
    EXECUTE 'EXPLAIN (FORMAT JSON) ' || query INTO result;
    RETURN result->0->'Plan';
END
$$;

query I
SELECT (bm25_test_plan($q$
SELECT id FROM cost_documents ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25') LIMIT 10
$q$)::text LIKE '%"Index Name": "cost_documents_bm25"%')::int;
----
1

statement ok
INSERT INTO cost_documents SELECT i, to_tsvector('simple', 'search extra ' || i) FROM generate_series(50001, 56000) AS i;

statement ok
VACUUM (ANALYZE) cost_documents;

query I
SELECT (bm25_test_plan($q$
SELECT id FROM cost_documents ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25') LIMIT 10
$q$)::text LIKE '%"Index Name": "cost_documents_bm25"%')::int;
----
1

# A selective B-tree must remain competitive, even with a high scalar COST.
query I
SELECT (bm25_test_plan($q$
SELECT id FROM cost_documents WHERE id = 1 ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25') LIMIT 10
$q$)::text LIKE '%"Index Name": "cost_documents_pkey"%')::int;
----
1

statement ok
SET bm25.enable_scan = off;

query I
SELECT (bm25_test_plan($q$
SELECT id FROM cost_documents ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25') LIMIT 10
$q$)::text NOT LIKE '%"Index Name": "cost_documents_bm25"%')::int;
----
1

statement ok
RESET bm25.enable_scan;

# PG18 disabled-node ordering must not choose an unsupported unordered scan.
statement ok
CREATE TABLE no_order (v tsvector);

statement ok
CREATE INDEX no_order_bm ON no_order USING bm25(v bm25_ops);

statement ok
INSERT INTO no_order VALUES('alpha:1'),(NULL);

statement ok
SET enable_seqscan = off;

query I
SELECT count(*) FROM no_order;
----
2

statement ok
RESET enable_seqscan;

# Zero-column queries must never choose an Index Only Scan (bm25 cannot return tuple data).
query II
SELECT (bm25_test_plan($q$
SELECT 1 FROM cost_documents ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25') LIMIT 5
$q$)::text LIKE '%"Node Type": "Index Scan"%')::int,
(bm25_test_plan($q$
SELECT 1 FROM cost_documents ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25') LIMIT 5
$q$)::text NOT LIKE '%Index Only Scan%')::int;
----
1 1

# Two ORDER BY keys cannot be served by one BM25 scan; never plan it, even
# when both sequential scans and sorts are disabled, and never produce NaN costs.
statement ok
SET enable_seqscan = off;

statement ok
SET enable_sort = off;

query I
SELECT count(*) FROM (
  SELECT id FROM cost_documents
  ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25'),
           vector <&> to_bm25query(to_tsvector('simple', 'term'), 'cost_documents_bm25')
  LIMIT 5
) AS ranked;
----
5

query I
SELECT (bm25_test_plan($q$
SELECT id FROM cost_documents
ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25'),
         vector <&> to_bm25query(to_tsvector('simple', 'term'), 'cost_documents_bm25')
LIMIT 5
$q$)::text !~* 'nan|infinity')::int;
----
1

statement ok
RESET enable_sort;

statement ok
RESET enable_seqscan;

# to_bm25query() is not inlined; a generic plan with a constant target index
# and a parameterized query vector still uses the index.
statement ok
SET plan_cache_mode = force_generic_plan;

statement ok
PREPARE bm25_generic(text) AS
SELECT id FROM cost_documents ORDER BY vector <&> to_bm25query(to_tsvector('simple', $1), 'cost_documents_bm25') LIMIT 10;

query I
SELECT (bm25_test_plan($q$EXECUTE bm25_generic('search')$q$)::text LIKE '%"Index Name": "cost_documents_bm25"%')::int;
----
1

statement ok
DEALLOCATE bm25_generic;

statement ok
RESET plan_cache_mode;

# A zero score is +0, not -0.
query T
SELECT (vector <&> to_bm25query(to_tsvector('simple', 'nosuchterm'), 'cost_documents_bm25'))::text
FROM cost_documents WHERE id = 1;
----
0

# PG18+ EXPLAIN ANALYZE reports Index Searches accurately across batches and rescans.
statement ok
DO $$
DECLARE
    line text;
    plan_text text := '';
BEGIN
    IF current_setting('server_version_num')::int >= 180000 THEN
        PERFORM set_config('bm25.limit', '3', true);
        FOR line IN EXECUTE $ex$
            EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
            SELECT id FROM cost_documents
            ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25')
            LIMIT 10
        $ex$ LOOP
            plan_text := plan_text || line || E'\n';
        END LOOP;
        IF strpos(plan_text, 'Index Searches: 1') = 0 THEN
            RAISE EXCEPTION 'expected Index Searches: 1 in EXPLAIN output: %', plan_text;
        END IF;
        plan_text := '';
        FOR line IN EXECUTE $ex$
            EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
            SELECT results.id
            FROM (VALUES ('search'), ('term')) AS q(word)
            CROSS JOIN LATERAL (
                SELECT id FROM cost_documents
                ORDER BY vector <&> to_bm25query(to_tsvector('simple', q.word), 'cost_documents_bm25')
                LIMIT 3
            ) AS results
        $ex$ LOOP
            plan_text := plan_text || line || E'\n';
        END LOOP;
        IF strpos(plan_text, 'Index Searches: 2') = 0 THEN
            RAISE EXCEPTION 'expected Index Searches: 2 in EXPLAIN output: %', plan_text;
        END IF;
    END IF;
END
$$;

# pg_stat_user_indexes.idx_scan tracks BM25 searches accurately across batches and rescans on PG 15-19.
statement ok
DO $$
DECLARE
    before_scans bigint;
    after_single bigint;
    after_lateral bigint;
BEGIN
    PERFORM set_config('bm25.limit', '3', true);
    before_scans := pg_stat_get_xact_numscans('cost_documents_bm25'::regclass);
    PERFORM id FROM cost_documents
    ORDER BY vector <&> to_bm25query(to_tsvector('simple', 'search'), 'cost_documents_bm25')
    LIMIT 10;
    after_single := pg_stat_get_xact_numscans('cost_documents_bm25'::regclass);
    IF after_single - before_scans <> 1 THEN
        RAISE EXCEPTION 'expected +1 xact numscans for single multi-batch scan, got %', after_single - before_scans;
    END IF;
    PERFORM results.id
    FROM (VALUES ('search'), ('term')) AS q(word)
    CROSS JOIN LATERAL (
        SELECT id FROM cost_documents
        ORDER BY vector <&> to_bm25query(to_tsvector('simple', q.word), 'cost_documents_bm25')
        LIMIT 3
    ) AS results;
    after_lateral := pg_stat_get_xact_numscans('cost_documents_bm25'::regclass);
    IF after_lateral - after_single <> 2 THEN
        RAISE EXCEPTION 'expected +2 xact numscans for lateral rescan, got %', after_lateral - after_single;
    END IF;
END
$$;

statement ok
SELECT pg_stat_force_next_flush();

statement ok
SELECT pg_stat_clear_snapshot();

query I
SELECT (pg_stat_get_numscans('cost_documents_bm25'::regclass) >= 3)::int;
----
1

# Repeated SQL-function BM25 index scans execute cleanly in per-execution query contexts.
statement ok
CREATE FUNCTION bm25_top1_id(term text) RETURNS integer LANGUAGE plpgsql STABLE AS $$
DECLARE
    top_id integer;
BEGIN
    SELECT id INTO top_id
    FROM cost_documents
    ORDER BY vector <&> to_bm25query(to_tsvector('simple', term), 'cost_documents_bm25')
    LIMIT 1;
    RETURN top_id;
END
$$;

query I
SELECT count(*) FROM generate_series(1, 50) AS g WHERE bm25_top1_id('search') IS NOT NULL;
----
50

statement ok
DROP FUNCTION bm25_top1_id(text);

statement ok
DROP FUNCTION bm25_test_plan(text);

statement ok
DROP TABLE cost_documents, no_order;
